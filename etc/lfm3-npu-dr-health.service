[Unit]
Description=LFM3-1.7B Disaster Recovery Health Check
After=lfm3-npu-npu.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /media/scott/data/lfm3-npu-tool/bin/lfm3-npu dr check-health
WorkingDirectory=/media/scott/data/lfm3-npu-tool
Environment=PYTHONPATH=/media/scott/data/lfm3-npu-tool/lib

[Install]
WantedBy=default.target
