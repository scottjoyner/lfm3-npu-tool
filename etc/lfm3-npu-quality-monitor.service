[Unit]
Description=LFM3-1.7B Quality Monitor (auto-restart CPU on degradation)
After=network-online.target lfm3-npu-cpu.service lfm3-npu-npu.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /media/scott/data/lfm3-npu-tool/scripts/quality_monitor.py --interval 300 --fix --restart-cooldown 600
Restart=always
RestartSec=30
Environment=TMPDIR=/media/scott/data/tmp
Environment=PATH=/usr/bin:/bin

[Install]
WantedBy=default.target
