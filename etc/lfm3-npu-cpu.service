[Unit]
Description=LFM3-1.7B CPU Inference Server (ONNX Runtime, port 1238)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/media/scott/data/ryzen-ai-venv/bin/python -B /media/scott/data/lfm3-npu-tool/lib/lfm3_npu/cpu_batched_server.py --host 0.0.0.0 --port 1238
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
Environment=TMPDIR=/media/scott/data/tmp
Environment=LD_LIBRARY_PATH=/media/scott/data/ryzen-ai-venv/lib/python3.12/site-packages/flexml/flexml_extras/lib:/media/scott/data/ryzen-ai-venv/lib/python3.12/site-packages/voe/lib:/opt/xilinx/xrt/lib
Environment=XLNX_CACHE_DIR=/media/scott/data/vitisai_cache
Environment=PATH=/opt/xilinx/xrt/bin:/usr/bin:/bin
Environment=LFM3_ENV=production
Environment=LFM3_LOG_FORMAT=json
Environment=LFM3_TRACING_ENABLED=true
Environment=LFM3_OTLP_ENDPOINT=http://localhost:14318/api/otlp
# Enterprise: TLS/HTTPS. Uncomment to serve over HTTPS with dev certs:
# Environment=LFM3_TLS_ENABLED=true
# Environment=LFM3_TLS_DIR=/media/scott/data/lfm3-npu-tool/etc/tls
# Enterprise: rate limiting (requests per minute, burst). Uncomment & set API keys in production.
# Environment=LFM3_API_KEY=sk-live-abc123            (batched_server.py / cpu_server.py)
# Environment=LFM3_API_KEYS=sk-live-abc123:prod-web  (npu_server.py / EnterpriseMiddleware)
# Environment=LFM3_RATE_LIMIT_RPM=60
# Environment=LFM3_RATE_LIMIT_BURST=10
# Enterprise: SLO targets
# Environment=LFM3_SLO_AVAILABILITY=99.9
# Environment=LFM3_SLO_LATENCY_P95_MS=5000
# Enterprise: input validation limits
# Environment=LFM3_MAX_PROMPT_CHARS=4000
# Environment=LFM3_MAX_PROMPT_TOKENS=1024
# Environment=LFM3_MAX_MESSAGES=20
# Environment=LFM3_DENY_LIST=10.0.0.1
# Environment=LFM3_ALLOW_LIST=
# Enterprise: security headers
# Environment=LFM3_SECURITY_HSTS_MAX_AGE=31536000
# Environment=LFM3_SECURITY_DISABLE_HSTS=0
# Enterprise: audit logging
# Environment=LFM3_AUDIT_SERVICE_NAME=lfm3-inference
# Enterprise: load shedding
# Environment=LFM3_LOAD_SHED_MAX_ACTIVE=100

[Install]
WantedBy=default.target
