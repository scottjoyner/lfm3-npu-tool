[Unit]
Description=LFM3-1.7B CPU Inference Server (ONNX Runtime, port 1238)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Do not compete with an already-bound CPU port (including cron-owned servers).
# Exit 1 from ExecCondition skips startup without a retry storm.
ExecCondition=/usr/bin/python3 -B /media/scott/data/lfm3-npu-tool/scripts/cpu_port_guard.py
ExecStart=/media/scott/data/ryzen-ai-venv/bin/python -B /media/scott/data/lfm3-npu-tool/lib/lfm3_npu/cpu_batched_server.py --host 0.0.0.0 --port 1238
Restart=always
# Uvicorn binding failures exit 3; avoid endless competing port-start attempts.
RestartPreventExitStatus=3
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
Environment=TMPDIR=/media/scott/data/tmp
Environment=LD_LIBRARY_PATH=/media/scott/data/ryzen-ai-venv/lib/python3.12/site-packages/flexml/flexml_extras/lib:/media/scott/data/ryzen-ai-venv/lib/python3.12/site-packages/voe/lib:/opt/xilinx/xrt/lib
Environment=XLNX_CACHE_DIR=/media/scott/data/vitisai_cache
Environment=PATH=/opt/xilinx/xrt/bin:/usr/bin:/bin
Environment=LFM3_TRACING_ENABLED=true
Environment=LFM3_OTLP_ENDPOINT=http://localhost:14318/api/otlp

[Install]
WantedBy=default.target
