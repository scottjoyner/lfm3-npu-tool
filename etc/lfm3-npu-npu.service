[Unit]
Description=LFM3-1.7B NPU Inference Server (FastFlowLM, port 1239)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Kill any stale FLM processes holding port 1239 before starting
ExecStartPre=/bin/bash -c 'pkill -f "flm serve lfm3:1.7b" 2>/dev/null || true; pkill -f "flm-real serve lfm3:1.7b" 2>/dev/null || true; sleep 2'
ExecStart=/tmp/flm serve lfm3:1.7b -p 1239 --host 127.0.0.1
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
Environment=TMPDIR=/media/scott/data/tmp
Environment=LD_LIBRARY_PATH=/tmp/lib:/opt/xilinx/xrt/lib
Environment=XILINX_XRT=/opt/xilinx/xrt
Environment=FLM_MODEL_PATH=/home/scott/.config/flm/models
Environment=PATH=/opt/xilinx/xrt/bin:/usr/bin:/bin
Environment=LFM3_ENV=production
# Enterprise: TLS/HTTPS. Uncomment to serve over HTTPS with dev certs:
# Environment=LFM3_TLS_ENABLED=true
# Environment=LFM3_TLS_DIR=/media/scott/data/lfm3-npu-tool/etc/tls
# Enterprise: rate limiting (requests per minute, burst). Uncomment & set API keys in production.
# Environment=LFM3_API_KEYS=sk-live-abc123:prod-web
# Environment=LFM3_RATE_LIMIT_RPM=60
# Environment=LFM3_RATE_LIMIT_BURST=10

[Install]
WantedBy=default.target
