def cmd_version_check(args) -> int:
    """Check for FastFlowLM version updates."""
    import subprocess
    import urllib.request
    import json
    import tarfile
    import shutil

    print("Checking FastFlowLM version...", flush=True)

    # Check current version from running server
    try:
        data = json.loads(urllib.request.urlopen(
            "http://127.0.0.1:1239/v1/models", timeout=10
        ).read().decode("utf-8"))
        models = data.get("data", [])
        lfm_models = [m for m in models if "lfm3" in str(m.get("id", ""))]
        if lfm_models:
            print(f"  NPU model: {lfm_models[0]['id']}")
    except Exception as e:
        print(f"  Could not query NPU server: {e}", flush=True)

    # Check latest release from GitHub
    try:
        req = urllib.request.Request(
            "https://api.github.com/repos/ROCm/FastFlowLM/releases/latest",
            headers={"User-Agent": "lfm3-npu-tool"}
        )
        release = json.loads(urllib.request.urlopen(req, timeout=10).read().decode("utf-8"))
        latest_tag = release.get("tag_name", "unknown")
        latest_name = release.get("name", "unknown")
        print(f"  Latest release: {latest_tag} ({latest_name})")

        # Compare with known version
        current = "v1.0.12"
        if latest_tag and latest_tag != current:
            print(f"  UPDATE AVAILABLE: {current} -> {latest_tag}")
            if args.upgrade:
                print(f"  Downloading {latest_tag}...")
                assets = release.get("assets", [])
                linux_asset = None
                for a in assets:
                    if "linux" in a.get("name", "").lower() and a.get("name", "").endswith(".tar.gz"):
                        linux_asset = a
                        break
                if linux_asset:
                    download_url = linux_asset["browser_download_url"]
                    asset_name = linux_asset["name"]
                    print(f"  Asset: {asset_name}")
                    print(f"  URL: {download_url}")

                    # Stop NPU server before upgrade
                    print(f"  Stopping NPU server...")
                    subprocess.run(
                        ["systemctl", "--user", "stop", "lfm3-npu-npu.service"],
                        capture_output=True, text=True, timeout=30
                    )

                    # Download to /tmp
                    download_path = f"/tmp/{asset_name}"
                    try:
                        urllib.request.urlretrieve(download_url, download_path)
                        print(f"  Downloaded to {download_path}")
                    except Exception as e:
                        print(f"  Download failed: {e}")
                        print(f"  Restarting NPU server...")
                        subprocess.run(
                            ["systemctl", "--user", "start", "lfm3-npu-npu.service"],
                            capture_output=True, text=True, timeout=30
                        )
                        return 1

                    # Extract
                    extract_dir = "/tmp/flm-upgrade"
                    os.makedirs(extract_dir, exist_ok=True)
                    try:
                        with tarfile.open(download_path, "r:gz") as tar:
                            tar.extractall(extract_dir)
                        print(f"  Extracted to {extract_dir}")
                    except Exception as e:
                        print(f"  Extraction failed: {e}")
                        print(f"  Restarting NPU server...")
                        subprocess.run(
                            ["systemctl", "--user", "start", "lfm3-npu-npu.service"],
                            capture_output=True, text=True, timeout=30
                        )
                        return 1

                    # Find the flm binary in extracted files
                    flm_binary = None
                    for root, dirs, files in os.walk(extract_dir):
                        for f in files:
                            if f == "flm" or f.startswith("flm-"):
                                candidate = os.path.join(root, f)
                                if os.access(candidate, os.X_OK):
                                    flm_binary = candidate
                                    break
                        if flm_binary:
                            break

                    if flm_binary:
                        # Back up old binary
                        old_backup = f"/tmp/flm.backup.{int(__import__('time').time())}"
                        shutil.copy2("/tmp/flm", old_backup)
                        print(f"  Backed up old binary to {old_backup}")

                        # Install new binary
                        shutil.copy2(flm_binary, "/tmp/flm")
                        os.chmod("/tmp/flm", 0o755)
                        print(f"  Installed new binary from {flm_binary}")

                        # Find and copy liblfm3_npu.so if present
                        for root, dirs, files in os.walk(extract_dir):
                            for f in files:
                                if "liblfm3_npu" in f and f.endswith(".so"):
                                    src = os.path.join(root, f)
                                    shutil.copy2(src, "/tmp/lib/")
                                    print(f"  Copied {f} to /tmp/lib/")
                                    break

                        # Restart NPU server
                        print(f"  Starting NPU server...")
                        result = subprocess.run(
                            ["systemctl", "--user", "start", "lfm3-npu-npu.service"],
                            capture_output=True, text=True, timeout=30
                        )
                        if result.returncode == 0:
                            print(f"  NPU server started successfully.")
                            # Verify
                            time.sleep(5)
                            try:
                                data = json.loads(urllib.request.urlopen(
                                    "http://127.0.0.1:1239/v1/models", timeout=10
                                ).read().decode("utf-8"))
                                models = data.get("data", [])
                                lfm = [m for m in models if "lfm3" in str(m.get("id", ""))]
                                if lfm:
                                    print(f"  Upgrade verified: {lfm[0]['id']} responding")
                                else:
                                    print(f"  WARNING: NPU server running but no lfm3 model found")
                            except Exception as e:
                                print(f"  WARNING: Could not verify upgrade: {e}")
                        else:
                            print(f"  Failed to start NPU server: {result.stderr}")
                            print(f"  Rollback: restoring old binary...")
                            shutil.copy2(old_backup, "/tmp/flm")
                            os.chmod("/tmp/flm", 0o755)
                            subprocess.run(
                                ["systemctl", "--user", "start", "lfm3-npu-npu.service"],
                                capture_output=True, text=True, timeout=30
                            )
                            return 1
                    else:
                        print("  Could not find flm binary in extracted archive")
                        print("  Restarting NPU server...")
                        subprocess.run(
                            ["systemctl", "--user", "start", "lfm3-npu-npu.service"],
                            capture_output=True, text=True, timeout=30
                        )
                        return 1

                    # Cleanup
                    try:
                        shutil.rmtree(extract_dir)
                        os.remove(download_path)
                    except Exception:
                        pass
                else:
                    print("  No Linux release asset found")
            else:
                print("  Run 'lfm3-npu version-check --upgrade' to download and install")
        else:
            print(f"  Already on latest version ({current})")
    except Exception as e:
        print(f"  Could not check latest version: {e}", flush=True)

    return 0


def cmd_validate(args) -> int:
    """Run startup validation of all LFM3 services."""
    import subprocess

    script = os.path.join(SERVER_DIR, "scripts", "startup-validate.py")
    if not os.path.exists(script):
        print(f"Startup validation script not found: {script}", flush=True)
        return 1

    print("Running startup validation...", flush=True)
    result = subprocess.run(["python3", script], capture_output=False)
    return result.returncode


def cmd_recover(args) -> int:
    """Recover all LFM3 servers (stop, start, wait for health)."""
    import subprocess
    import time

    print("=" * 60)
    print("LFM3-1.7B Server Recovery")
    print("=" * 60)

    # Stop all services
    print("\n[1/4] Stopping all LFM3 services...")
    for svc in ["lfm3-npu-cpu.service", "lfm3-npu-npu.service",
                "lfm3-npu-metrics.service", "lfm3-npu-quality-monitor.service"]:
        result = subprocess.run(
            ["systemctl", "--user", "stop", svc],
            capture_output=True, text=True, timeout=30
        )
        if result.returncode == 0:
            print(f"  Stopped: {svc}")
        else:
            print(f"  Warning: could not stop {svc}: {result.stderr.strip()}")

    # Wait for processes to fully stop
    print("  Waiting for processes to stop...")
    time.sleep(5)

    # Kill any remaining processes
    subprocess.run(["pkill", "-f", "flm serve"], capture_output=True, timeout=10)
    subprocess.run(["pkill", "-f", "cpu_batched_server"], capture_output=True, timeout=10)
    subprocess.run(["pkill", "-f", "npu_metrics_exporter"], capture_output=True, timeout=10)
    subprocess.run(["pkill", "-f", "quality_monitor"], capture_output=True, timeout=10)
    time.sleep(2)

    # Start all services
    print("\n[2/4] Starting all LFM3 services...")
    for svc in ["lfm3-npu-cpu.service", "lfm3-npu-npu.service",
                "lfm3-npu-metrics.service", "lfm3-npu-quality-monitor.service"]:
        result = subprocess.run(
            ["systemctl", "--user", "start", svc],
            capture_output=True, text=True, timeout=30
        )
        if result.returncode == 0:
            print(f"  Started: {svc}")
        else:
            print(f"  Failed to start {svc}: {result.stderr.strip()}")
            return 1

    # Wait for services to become healthy
    print("\n[3/4] Waiting for services to become healthy...")
    import urllib.request
    import json

    def fetch_json(url, timeout=5):
        try:
            req = urllib.request.urlopen(url, timeout=timeout)
            return json.loads(req.read().decode("utf-8")), None
        except Exception as e:
            return None, str(e)

    healthy = True
    for i in range(12):  # Wait up to 60 seconds
        cpu_ok, _ = fetch_json("http://127.0.0.1:1238/health", timeout=3)
        npu_ok, _ = fetch_json("http://127.0.0.1:1239/v1/models", timeout=3)
        if cpu_ok and npu_ok:
            print(f"  All services healthy after {i * 5}s")
            break
        print(f"  Waiting... ({i * 5}s)")
        time.sleep(5)
    else:
        print("  Services did not become healthy in time")
        healthy = False

    # Run final validation
    print("\n[4/4] Running validation...")
    script = os.path.join(SERVER_DIR, "scripts", "startup-validate.py")
    if os.path.exists(script):
        result = subprocess.run(["python3", script], capture_output=False)
        if result.returncode != 0:
            healthy = False

    print("\n" + "=" * 60)
    if healthy:
        print("RECOVERY COMPLETE: All servers restored and healthy")
        return 0
    else:
        print("RECOVERY INCOMPLETE: Some servers may still be unhealthy")
        return 1


def cmd_generate(args) -> int:
    """Generate text via HTTP API (cpu or npu server)."""
    _apply_tls_args(args)
    if args.server == "npu":
        try:
            result = generate_via_http(
                "npu", args.prompt,
                max_tokens=args.max_tokens,
                temperature=args.temperature,
                top_p=args.top_p,
            )
            print(f"Prompt: '{args.prompt}'", flush=True)
            if result["reasoning"] and not result["used_reasoning_fallback"]:
                print(f"Reasoning: {result['reasoning']}", flush=True)
            print(f"Content: {result['content']}", flush=True)
            usage = result.get("usage", {})
            if usage:
                print(f"Decode: {usage.get('decoding_speed_tps', 'N/A'):.1f} tok/s, "
                      f"TTFT: {usage.get('prefill_duration_ttft', 'N/A')}s")
            return 0
        except Exception as e:
            print(f"NPU generation failed: {e}", flush=True)
            print("Is the NPU server running? Try: lfm3-npu server start npu", flush=True)
            return 1
    else:
        # CPU server via LFM3NPUInference (direct Python API)
        config = load_config()
        model_path = args.model or config.get("server.cpu.model_path")
        tokenizer_path = args.tokenizer or config.get("model.tokenizer")

        print(f"Loading CPU model: {model_path}", flush=True)
        engine = LFM3NPUInference(model_path, tokenizer_path, config)
        engine.load()
        engine.warmup()

        print(f"Prompt: '{args.prompt}'", flush=True)
        print("Generated: ", end="", flush=True)

        result = engine.generate(
            args.prompt,
            max_new_tokens=args.max_tokens,
            temperature=args.temperature,
            top_p=args.top_p,
        )
        print(result, flush=True)
        print(f"\nFull text: '{args.prompt}{result}'", flush=True)
        return 0


def cmd_config_validate(args) -> int:
    """Validate configuration schema."""
    config = load_config()
    try:
        result = validate_config(config.to_dict())
        print("Configuration validation: PASSED")
        print(f"  Validated {len(result)} top-level sections")
        for key in sorted(result.keys()):
            print(f"  - {key}: OK")
        return 0
    except ConfigValidationError as e:
        print("Configuration validation: FAILED")
        for err in e.errors:
            print(f"  - {err}")
        return 1


def cmd_config_reload(args) -> int:
    """Trigger config hot-reload."""
    config_path = os.environ.get("LFM3_NPU_CONFIG", "")
    if not config_path:
        # Try to find config file
        from lfm3_npu.config import _find_config_file
        config_path = _find_config_file() or ""

    if not config_path:
        print("No configuration file found. Set LFM3_NPU_CONFIG env var.")
        return 1

    print(f"Watching config file: {config_path}")
    rc = ReloadableConfig(config_path)
    rc.start_watching()

    # Wait briefly for initial load
    import time as _time
    for _ in range(10):
        cfg = rc.get()
        if cfg is not None:
            break
        _time.sleep(0.5)

    cfg = rc.get()
    if cfg is None:
        print("Failed to load configuration.")
        rc.stop_watching()
        return 1

    print("Configuration loaded and validated successfully.")
    print(f"  server.cpu.port: {cfg.get('server.cpu.port')}")
    print(f"  server.npu.port: {cfg.get('server.npu.port')}")
    print(f"  logging.level: {cfg.get('logging.level')}")
    rc.stop_watching()
    return 0


def cmd_feature_flags(args) -> int:
    """List, get, set, enable, or disable feature flags."""
    flags = get_flags()

    if args.flag_action == "list":
        all_flags = flags.list_flags()
        print("Feature Flags:")
        print("=" * 60)
        for name in sorted(all_flags.keys()):
            flag = all_flags[name]
            status = "ON" if flag["enabled"] else "OFF"
            ftype = flag["type"]
            pct = f" ({flag['percentage']}%)" if ftype == "percentage" else ""
            print(f"  {name}: {status}{pct}  [{ftype}]")
            if flag["description"]:
                print(f"    {flag['description']}")
        return 0

    elif args.flag_action == "get":
        flag = flags.get_flag(args.flag_name)
        if flag is None:
            print(f"Feature flag '{args.flag_name}' not found.")
            return 1
        import json
        print(json.dumps(flag, indent=2))
        return 0

    elif args.flag_action == "set":
        enabled = args.flag_value.lower() in ("true", "1", "yes", "on")
        pct = args.percentage if args.percentage is not None else 0
        flags.set_flag(args.flag_name, enabled, flag_type="percentage" if args.percentage is not None else "boolean", percentage=pct)
        print(f"Feature flag '{args.flag_name}' set to {enabled}")
        return 0

    elif args.flag_action == "enable":
        flags.set_flag(args.flag_name, True)
        print(f"Feature flag '{args.flag_name}' enabled.")
        return 0

    elif args.flag_action == "disable":
        flags.set_flag(args.flag_name, False)
        print(f"Feature flag '{args.flag_name}' disabled.")
        return 0

    return 1


def cmd_backup(args) -> int:
    """Create, list, verify, restore, or delete backups."""
    bm = get_backup_manager()

    if args.backup_action == "create":
        name = args.name or None
        desc = args.description or None
        print(f"Creating backup: {name or 'auto-generated name'}...")
        backup_name = bm.create_backup(name=name, description=desc)
        print(f"Backup created: {backup_name}")
        return 0

    elif args.backup_action == "list":
        backups = bm.list_backups()
        if not backups:
            print("No backups found.")
            return 0
        print("Backups:")
        print("=" * 80)
        for b in backups:
            print(f"  {b['filename']}")
            print(f"    Created: {b['created_at']}")
            print(f"    Size: {b['size_bytes']} bytes, Files: {b['file_count']}")
        return 0

    elif args.backup_action == "verify":
        result = bm.verify_backup(args.backup_name)
        if result["valid"]:
            print(f"Backup '{args.backup_name}': VALID")
            print(f"  Verified {result['verified_files']} files")
        else:
            print(f"Backup '{args.backup_name}': INVALID")
            if result.get("error"):
                print(f"  Error: {result['error']}")
            for f in result.get("failed_files", []):
                print(f"  Failed: {f['path']} - {f.get('error', 'unknown')}")
            return 1
        return 0

    elif args.backup_action == "restore":
        dest = args.destination or "/"
        print(f"Restoring backup '{args.backup_name}' to {dest}...")
        bm.restore_backup(args.backup_name, destination=dest)
        print(f"Backup restored to {dest}")
        return 0

    elif args.backup_action == "delete":
        bm.delete_backup(args.backup_name)
        print(f"Backup '{args.backup_name}' deleted.")
        return 0

    return 1


def cmd_audit(args) -> int:
    """Show recent audit log entries."""
    import glob
    import json

    audit_dir = "/media/scott/data/lfm3-npu-tool/var/log"
    audit_files = sorted(glob.glob(os.path.join(audit_dir, "audit*.log")) + 
                         glob.glob(os.path.join(audit_dir, "*.jsonl")))

    if not audit_files:
        print("No audit log files found.")
        return 0

    limit = args.limit or 50
    count = 0
    for afile in reversed(audit_files):
        try:
            with open(afile, "r") as f:
                for line in reversed(f.readlines()):
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                        print(json.dumps(entry, indent=None))
                        count += 1
                        if count >= limit:
                            return 0
                    except json.JSONDecodeError:
                        print(line)
                        count += 1
                        if count >= limit:
                            return 0
        except Exception as e:
            print(f"Error reading {afile}: {e}")
    return 0
    """Generate text via HTTP API (cpu or npu server)."""
    _apply_tls_args(args)
    if args.server == "npu":
        try:
            result = generate_via_http(
                "npu", args.prompt,
                max_tokens=args.max_tokens,
                temperature=args.temperature,
                top_p=args.top_p,
            )
            print(f"Prompt: '{args.prompt}'", flush=True)
            if result["reasoning"] and not result["used_reasoning_fallback"]:
                print(f"Reasoning: {result['reasoning']}", flush=True)
            print(f"Content: {result['content']}", flush=True)
            usage = result.get("usage", {})
            if usage:
                print(f"Decode: {usage.get('decoding_speed_tps', 'N/A'):.1f} tok/s, "
                      f"TTFT: {usage.get('prefill_duration_ttft', 'N/A')}s")
            return 0
        except Exception as e:
            print(f"NPU generation failed: {e}", flush=True)
            print("Is the NPU server running? Try: lfm3-npu server start npu", flush=True)
            return 1
    else:
        # CPU server via LFM3NPUInference (direct Python API)
        config = load_config()
        model_path = args.model or config.get("server.cpu.model_path")
        tokenizer_path = args.tokenizer or config.get("model.tokenizer")

        print(f"Loading CPU model: {model_path}", flush=True)
        engine = LFM3NPUInference(model_path, tokenizer_path, config)
        engine.load()
        engine.warmup()

        print(f"Prompt: '{args.prompt}'", flush=True)
        print("Generated: ", end="", flush=True)

        result = engine.generate(
            args.prompt,
            max_new_tokens=args.max_tokens,
            temperature=args.temperature,
            top_p=args.top_p,
        )
        print(result, flush=True)
        print(f"\nFull text: '{args.prompt}{result}'", flush=True)
        return 0


def cmd_server(args) -> int:
    """Start/stop/restart/check server status."""
    config = load_config()
    manager = ServerManager(config)

    if args.action == "start":
        return 0 if manager.start(args.server) else 1
    elif args.action == "stop":
        return 0 if manager.stop(args.server) else 1
    elif args.action == "restart":
        return 0 if manager.restart(args.server) else 1
    elif args.action == "status":
        manager.status(args.server)
        return 0
    return 1


def cmd_bench(args) -> int:
    """Benchmark inference performance via HTTP API."""
    _apply_tls_args(args)
    servers = ["cpu", "npu"] if args.server == "both" else [args.server]

    for server in servers:
        print(f"\n{'=' * 60}")
        print(f"Benchmarking {server.upper()} server (port {CPU_PORT if server == 'cpu' else NPU_PORT})")
        print(f"{'=' * 60}")

        # Check server is reachable first
        try:
            port = CPU_PORT if server == "cpu" else NPU_PORT
            host = CPU_HOST if server == "cpu" else NPU_HOST
            health_path = "/health" if server == "cpu" else "/v1/models"
            http_get(_server_url(host, port, health_path), timeout=5)
        except Exception as e:
            print(f"Server {server} is not reachable: {e}")
            print(f"  Start it with: lfm3-npu server start {server}")
            continue

        results = bench_via_http(
            server,
            prompt=args.prompt,
            max_tokens=args.tokens,
            iterations=args.iterations,
        )

        successful = [r for r in results if r["success"]]
        if successful:
            avg_total = sum(r["total_time"] for r in successful) / len(successful)
            ttfts = [r["ttft"] for r in successful if r["ttft"] is not None]
            decodes = [r["decode_tps"] for r in successful if r["decode_tps"] is not None]
            print(f"  Successful iterations: {len(successful)}/{len(results)}")
            print(f"  Avg total time:      {avg_total:.2f}s")
            if ttfts:
                print(f"  Avg TTFT:            {sum(ttfts)/len(ttfts):.3f}s")
            if decodes:
                print(f"  Avg decode speed:    {sum(decodes)/len(decodes):.1f} tok/s")
            for r in successful:
                print(f"  Iter {r['iteration']}: {r['total_time']:.2f}s, "
                      f"decode={r['decode_tps'] or 0:.1f} tok/s, "
                      f"content='{r['content'][:60]}'")
        else:
            print("  All iterations failed.")
            for r in results:
                if not r["success"]:
                    print(f"  Iter {r['iteration']}: {r['error']}")

    return 0


def cmd_bench_batch(args) -> int:
    """Benchmark concurrent inference performance."""
    from lfm3_npu.benchmark import bench_concurrency

    config = load_config()
    model_path = args.model or config.get("model.path")
    tokenizer_path = args.tokenizer or config.get("model.tokenizer")

    concurrency_levels = None
    if args.concurrency:
        concurrency_levels = [int(c) for c in args.concurrency.split(",")]

    results = bench_concurrency(
        model_path,
        tokenizer_path,
        prompt=args.prompt,
        max_tokens=args.tokens,
        concurrency_levels=concurrency_levels,
        config=config,
    )

    print("\n=== Performance Profile Summary ===")
    best_tps = 0
    best_conc = 1
    for level in results["results"]:
        tps = level["avg_tokens_per_sec"]
        if tps > best_tps:
            best_tps = tps
            best_conc = level["concurrency"]
        print(
            f"  Concurrency {level['concurrency']:2d}: "
            f"{tps:6.1f} tok/s, "
            f"TTFT={level.get('avg_ttft_ms', 0):6.1f}ms, "
            f"prefill={level['avg_prefill_ms']:6.1f}ms"
        )
    print(
        f"\n  Best concurrency: {best_conc} "
        f"({best_tps:.1f} tok/s)"
    )
    return 0


def cmd_health(args) -> int:
    """Check server health."""
    import json

    _apply_tls_args(args)
    config = load_config()
    server = args.server

    if server == "cpu":
        port = config.get("server.cpu.port", CPU_PORT)
        host = config.get("server.cpu.host", CPU_HOST)
        health_path = "/health"
    elif server == "npu":
        port = config.get("server.npu.port", NPU_PORT)
        host = config.get("server.npu.host", NPU_HOST)
        health_path = "/v1/models"
    else:
        print(f"Unknown server: {server}")
        return 1

    try:
        data = http_get(_server_url(host, port, health_path), timeout=5)
        print(f"{server.upper()} server at {host}:{port}: HEALTHY")
        print(json.dumps(data, indent=2))
        return 0
    except Exception as e:
        print(f"{server.upper()} server at {host}:{port}: UNREACHABLE ({e})")
        return 1


