def cmd_compare(args) -> int:
    """Compare CPU vs NPU inference performance and output quality."""
    config = load_config()
    cpu_model = args.cpu_model or config.get("server.cpu.model_path")
    npu_model = args.npu_model or config.get("model.path")
    tokenizer_path = args.tokenizer or config.get("model.tokenizer")

    prompts = args.prompts or ["The quick brown fox", "Hello world", "Once upon a time"]

    print(f"Comparing CPU vs NPU inference")
    print(f"  CPU model:  {cpu_model}")
    print(f"  NPU model:  {npu_model}")
    print(f"  Prompts:    {len(prompts)}")
    print(f"  Max tokens: {args.max_tokens}")
    print()

    results = compare(
        cpu_model,
        npu_model,
        tokenizer_path,
        prompts,
        max_tokens=args.max_tokens,
        temperature=args.temperature,
        top_p=args.top_p,
        config=config,
    )

    summary = results["summary"]
    print("\n" + "=" * 60)
    print("FINAL COMPARISON SUMMARY")
    print("=" * 60)
    print(f"  Total prompts: {summary['total_prompts']}")
    print(f"  Text matches:  {summary['text_matches']}/{summary['total_prompts']} "
          f"({summary['match_rate']*100:.1f}%)")
    print(f"  Avg CPU:  {summary['avg_cpu_tokens_per_sec']:.1f} tok/s, "
          f"prefill={summary['avg_cpu_prefill_ms']:.1f}ms")
    print(f"  Avg NPU:  {summary['avg_npu_tokens_per_sec']:.1f} tok/s, "
          f"prefill={summary['avg_npu_prefill_ms']:.1f}ms")
    print(f"  NPU/CPU speed ratio: {summary['avg_speed_ratio']:.2f}x")
    return 0


def cmd_compare_servers(args) -> int:
    """Compare CPU vs NPU via live HTTP API servers."""
    _apply_tls_args(args)
    prompts = args.prompts or ["What is 2+2?", "The capital of France is", "Write a haiku about coding"]

    print("=" * 70)
    print("LIVE SERVER COMPARISON: CPU (1238) vs NPU (1239)")
    print("=" * 70)

    # Check both servers are reachable
    servers_ok = {}
    for name, host, port, path in [
        ("cpu", CPU_HOST, CPU_PORT, "/health"),
        ("npu", NPU_HOST, NPU_PORT, "/v1/models"),
    ]:
        try:
            http_get(_server_url(host, port, path), timeout=5)
            servers_ok[name] = True
        except Exception as e:
            servers_ok[name] = False
            print(f"WARNING: {name.upper()} server not reachable: {e}")

    if not any(servers_ok.values()):
        print("No servers are reachable. Start them with:")
        print("  lfm3-npu server start cpu")
        print("  lfm3-npu server start npu")
        return 1

    all_results = []
    for prompt in prompts:
        print(f"\n{'=' * 70}")
        print(f"Prompt: '{prompt}'")
        print(f"{'=' * 70}")

        prompt_result = {"prompt": prompt}

        for server in ["cpu", "npu"]:
            if not servers_ok.get(server):
                print(f"\n{server.upper()}: SKIPPED (not reachable)")
                prompt_result[server] = {"skipped": True}
                continue

            try:
                result = generate_via_http(
                    server, prompt,
                    max_tokens=args.max_tokens,
                    temperature=args.temperature,
                    top_p=args.top_p,
                )
                usage = result.get("usage", {})
                print(f"\n{server.upper()} server:")
                if result["reasoning"]:
                    print(f"  Reasoning: {result['reasoning'][:100]}...")
                print(f"  Content: {result['content'][:150]}")
                print(f"  Decode: {usage.get('decoding_speed_tps', 'N/A')} tok/s")
                print(f"  TTFT: {usage.get('prefill_duration_ttft', 'N/A')}s")
                prompt_result[server] = {
                    "content": result["content"],
                    "reasoning": result["reasoning"],
                    "decode_tps": usage.get("decoding_speed_tps"),
                    "ttft": usage.get("prefill_duration_ttft"),
                    "success": True,
                }
            except Exception as e:
                print(f"\n{server.upper()}: FAILED - {e}")
                prompt_result[server] = {"error": str(e), "success": False}

        all_results.append(prompt_result)

    # Summary
    print(f"\n{'=' * 70}")
    print("COMPARISON SUMMARY")
    print(f"{'=' * 70}")
    for r in all_results:
        print(f"\nPrompt: '{r['prompt']}'")
        for server in ["cpu", "npu"]:
            res = r.get(server, {})
            if res.get("skipped"):
                print(f"  {server.upper()}: skipped")
            elif res.get("success"):
                print(f"  {server.upper()}: {res['decode_tps'] or 0:.1f} tok/s, "
                      f"TTFT={res['ttft'] or 0:.2f}s")
            else:
                print(f"  {server.upper()}: failed")

    return 0


def cmd_doctor(args) -> int:
    """Diagnose system health: servers, NPU hardware, environment, configs."""
    import subprocess
    import shutil

    auto_fix = args.fix

    # Source environment from env file if available (for cron/systemd context)
    env_file = "/media/scott/data/lfm3-npu-tool/etc/lfm3-npu-env.sh"
    if os.path.exists(env_file):
        with open(env_file) as f:
            for line in f:
                line = line.strip()
                if line.startswith("export ") and "=" in line:
                    key, _, val = line[7:].partition("=")
                    # Strip quotes
                    val = val.strip('"').strip("'")
                    os.environ[key.strip()] = val

    issues = []
    checks = []

    def check(name, ok, detail=""):
        status = "PASS" if ok else "FAIL"
        checks.append((name, status, detail))
        if not ok:
            issues.append(f"{name}: {detail}")

    # 1. NPU hardware
    print("=== LFM3-1.7B Doctor: System Diagnosis ===\n")

    check("xrt-smi available", shutil.which("xrt-smi") is not None,
          "xrt-smi not found in PATH")
    try:
        result = subprocess.run(
            ["xrt-smi", "examine"], capture_output=True, text=True, timeout=10
        )
        npu_found = "Strix Halo" in result.stdout or "aie2p" in result.stdout
        check("NPU hardware detected", npu_found,
              "No Strix Halo NPU found in xrt-smi output")
        if npu_found:
            # Extract NPU device details
            for line in result.stdout.split("\n"):
                if "BDF" in line or "firmware" in line.lower() or "XDNA" in line:
                    print(f"    NPU detail: {line.strip()}")
    except Exception as e:
        check("NPU hardware detected", False, f"xrt-smi failed: {e}")

    # 1b. XRT version
    try:
        result = subprocess.run(
            ["xrt-smi", "version"], capture_output=True, text=True, timeout=10
        )
        xrt_version = result.stdout.strip() if result.returncode == 0 else "unknown"
        check("XRT version available", xrt_version != "unknown",
              f"XRT version: {xrt_version[:80] if xrt_version != 'unknown' else 'not available'}")
    except Exception:
        check("XRT version available", False, "xrt-smi version failed")

    # 1c. NPU device node
    npu_dev = "/dev/accel/accel0"
    check("NPU device node exists", os.path.exists(npu_dev),
          f"{npu_dev} not found (NPU may not be accessible)")

    # 2. FLM binary
    flm_binary = "/tmp/flm"
    check("FLM binary exists", os.path.exists(flm_binary),
          f"{flm_binary} not found")
    check("FLM binary executable", os.access(flm_binary, os.X_OK) if os.path.exists(flm_binary) else False,
          f"{flm_binary} not executable")
    # FLM version
    try:
        result = subprocess.run(
            [flm_binary, "--version"], capture_output=True, text=True, timeout=10
        )
        flm_version = result.stdout.strip() or result.stderr.strip()
        check("FLM version detectable", bool(flm_version),
              f"FLM version: {flm_version[:80] if flm_version else 'not detectable'}")
    except Exception:
        check("FLM version detectable", False, "Could not run flm --version")

    # 3. FLM NPU engine
    npu_engine = "/tmp/lib/liblfm3_npu.so"
    check("FLM NPU engine exists", os.path.exists(npu_engine),
          f"{npu_engine} not found")

    # 4. Model files
    model_dir = "/home/scott/.config/flm/models/LFM3-1.7B-NPU2"
    model_files = ["config.json", "model.q4nx", "tokenizer.json", "tokenizer_config.json", "chat_template.jinja"]
    all_model_files = all(os.path.exists(os.path.join(model_dir, f)) for f in model_files) if os.path.isdir(model_dir) else False
    check("FLM model files present", all_model_files,
          f"Missing model files in {model_dir}")

    # 5. CPU server model
    cpu_model = "/media/scott/data/lfm3_oga_export/model.onnx"
    check("CPU ONNX model exists", os.path.exists(cpu_model),
          f"{cpu_model} not found")

    # 6. Environment variables
    check("XILINX_XRT set", bool(os.environ.get("XILINX_XRT")),
          "XILINX_XRT not set (needed for FLM)")
    check("LD_LIBRARY_PATH has /tmp/lib", "/tmp/lib" in os.environ.get("LD_LIBRARY_PATH", ""),
          "/tmp/lib not in LD_LIBRARY_PATH (needed for liblfm3_npu.so)")
    check("FLM_MODEL_PATH set", bool(os.environ.get("FLM_MODEL_PATH")),
          "FLM_MODEL_PATH not set (needed for FLM model discovery)")

    # 6b. Config file validation
    config_path = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                               "etc", "lfm3-npu-config.yaml")
    config_exists = os.path.exists(config_path)
    check("Config file exists", config_exists,
          f"Config file not found at {config_path}")
    if config_exists:
        try:
            import yaml
            with open(config_path) as f:
                cfg = yaml.safe_load(f)
            check("Config is valid YAML", cfg is not None,
                  "Config file is not valid YAML")
            if cfg:
                check("Config has server section", "server" in cfg,
                      "Config missing 'server' section")
                check("Config has model section", "model" in cfg,
                      "Config missing 'model' section")
        except Exception as e:
            check("Config is valid YAML", False, str(e))

    # 7. Server health
    manager = ServerManager(load_config())
    for sname, host, port, path in [
        ("cpu", CPU_HOST, CPU_PORT, "/health"),
        ("npu", NPU_HOST, NPU_PORT, "/v1/models"),
    ]:
        try:
            http_get(_server_url(host, port, path), timeout=5)
            check(f"{sname.upper()} server reachable", True)
        except Exception as e:
            check(f"{sname.upper()} server reachable", False, f"Not reachable on {host}:{port} ({e})")

    # 8. Disk space
    try:
        stat = shutil.disk_usage("/media/scott/data")
        free_gb = stat.free / (1024**3)
        check("Disk space > 5GB", free_gb > 5,
              f"Only {free_gb:.1f}GB free on /media/scott/data")
    except Exception as e:
        check("Disk space check", False, str(e))

    # 9. /tmp space (FLM may write temp files)
    try:
        stat = shutil.disk_usage("/tmp")
        free_gb = stat.free / (1024**3)
        check("/tmp space > 2GB", free_gb > 2,
              f"Only {free_gb:.1f}GB free on /tmp")
    except Exception as e:
        check("/tmp space check", False, str(e))

    # Print results
    for name, status, detail in checks:
        mark = "✓" if status == "PASS" else "✗"
        detail_str = f" — {detail}" if status == "FAIL" and detail else ""
        print(f"  [{mark}] {name}{detail_str}")

    print(f"\n{'=' * 50}")
    if issues:
        print(f"DOCTOR: {len(issues)} issue(s) found")
        for i, issue in enumerate(issues, 1):
            print(f"  {i}. {issue}")

        if auto_fix:
            print("\n🔧 Auto-fixing issues...")
            fixed = []

            # Fix: restart unreachable servers
            if any("server reachable" in i for i in issues):
                for sname in ["cpu", "npu"]:
                    if any(f"{sname.upper()} server reachable" in i for i in issues):
                        print(f"  Restarting {sname.upper()} server...")
                        result = subprocess.run(
                            ["systemctl", "--user", "restart",
                             f"lfm3-npu-{sname}.service"],
                            capture_output=True, text=True, timeout=30
                        )
                        if result.returncode == 0:
                            print(f"  ✓ {sname.upper()} server restarted")
                            fixed.append(sname)
                        else:
                            print(f"  ✗ Failed to restart {sname.upper()}: {result.stderr.strip()}")

            # Wait for servers to come up
            if fixed:
                print("  Waiting 15s for servers to stabilize...")
                time.sleep(15)

            # Fix: FLM binary missing
            if any("FLM binary" in i for i in issues):
                print("  FLM binary missing - run 'lfm3-npu version-check --upgrade' to download")

            # Fix: NPU engine missing
            if any("NPU engine" in i for i in issues):
                print("  NPU engine missing - run 'lfm3-npu version-check --upgrade' to download")

            # Fix: Disk space
            if any("Disk space" in i or "/tmp space" in i for i in issues):
                print("  Disk space low - free space manually or move large files to /media/scott/data")

            # Re-check after fixes
            print("\n🔄 Re-checking after fixes...")
            remaining_issues = []
            for sname, host, port, path in [
                ("cpu", CPU_HOST, CPU_PORT, "/health"),
                ("npu", NPU_HOST, NPU_PORT, "/v1/models"),
            ]:
                try:
                    http_get(_server_url(host, port, path), timeout=5)
                except Exception as e:
                    remaining_issues.append(f"{sname.upper()} server still unreachable: {e}")

            if remaining_issues:
                print(f"  {len(remaining_issues)} issue(s) remain after auto-fix")
                for issue in remaining_issues:
                    print(f"  - {issue}")
                return 1
            else:
                print("  All issues resolved after auto-fix")
                return 0
        else:
            print("\nRecommended actions:")
            if any("FLM binary" in i for i in issues):
                print("  - Download FLM v1.0.12 from https://github.com/ROCm/FastFlowLM/releases/tag/v1.0.12")
                print("    Extract to /tmp/ and ensure /tmp/flm is executable")
            if any("NPU engine" in i for i in issues):
                print("  - Extract liblfm3_npu.so from FLM release to /tmp/lib/")
            if any("server reachable" in i for i in issues):
                print("  - Start servers: lfm3-npu server start cpu  lfm3-npu server start npu")
                print("    Or run: lfm3-npu doctor --fix")
            if any("Disk space" in i or "/tmp space" in i for i in issues):
                print("  - Free disk space; use /media/scott/data for large files")
            if any("LD_LIBRARY_PATH" in i for i in issues):
                print("  - Export LD_LIBRARY_PATH=/tmp/lib:/opt/xilinx/xrt/lib:$LD_LIBRARY_PATH")
                print("    (Only needed when starting NPU server manually)")
            return 1
    else:
        print("DOCTOR: All checks passed. System is healthy.")
        return 0


def cmd_watchdog(args) -> int:
    """Run the server watchdog."""
    from lfm3_npu.watchdog import Watchdog
    config = load_config()
    watchdog = Watchdog(
        config,
        check_interval=args.interval,
        min_tps=args.min_tps,
        max_error_rate=args.max_error_rate,
        max_latency_ms=args.max_latency_ms,
        max_uptime_hours=args.max_uptime_hours,
        max_garble_ratio=args.max_garble_ratio,
        webhook_url=args.webhook,
        cooldown_seconds=args.cooldown,
        enable_degradation=args.degrade,
        min_concurrent_requests=args.min_concurrent,
    )
    if args.status:
        import json
        status = watchdog.get_status(args.servers)
        print(json.dumps(status, indent=2))
        return 0
    if args.once:
        results = watchdog.check_once(args.servers)
        for server, action_taken in results.items():
            action = "restarted" if action_taken else "healthy"
            print(f"Watchdog: {server.upper()} - {action}")
        return 0
    else:
        watchdog.run_forever(args.servers)
        return 0


