#!/usr/bin/env python3
"""
LFM3-1.7B NPU Inference Tooling - Unified CLI

Usage:
    lfm3-npu <command> [options]

Commands:
    generate        Generate text via HTTP API (cpu or npu server)
    server          Start/stop/restart/check inference server
    bench           Benchmark inference performance via HTTP API
    perf            Benchmark concurrent inference performance
    health          Check server health
    convert         Convert model to NPU-compatible format
    config          Show current configuration
    status          Show overall system status
    compare         Compare CPU vs NPU inference (side-by-side)
    compare-servers Compare CPU vs NPU via HTTP API (live servers)
    doctor          Diagnose system health (servers, NPU, env, disk)
    watchdog        Run server watchdog (auto-restart unresponsive servers)
    fleet-monitor   Fleet monitoring across servers
    smoke-test      Run smoke test / validation of all servers
    quality-monitor Run quality monitor with auto-restart on degradation
    version-check   Check for FastFlowLM version updates
    benchmark-cron  Run benchmark cron job (periodic performance validation)

Examples:
    lfm3-npu generate "The quick brown fox" --server npu --max-tokens 50
    lfm3-npu generate "What is 2+2?" --server cpu --max-tokens 30
    lfm3-npu server start npu          # Start FLM NPU server (port 1239)
    lfm3-npu server start cpu          # Start CPU server (port 1238)
    lfm3-npu server status             # Check both servers with health
    lfm3-npu bench --server npu --prompt "Hello" --tokens 50
    lfm3-npu bench --server both --prompt "Hello" --tokens 50
    lfm3-npu health --server npu
    lfm3-npu compare-servers --prompts "What is 2+2?" "The capital of France is"
    lfm3-npu doctor                    # Run full system diagnosis
    lfm3-npu watchdog --once
    lfm3-npu watchdog --daemon --interval 30
    lfm3-npu smoke-test              # Validate all servers
    lfm3-npu smoke-test --fix        # Validate + auto-restart unhealthy
    lfm3-npu quality-monitor --fix   # Monitor quality with auto-restart
    lfm3-npu version-check           # Check for FastFlowLM updates
    lfm3-npu version-check --upgrade # Show upgrade instructions
    lfm3-npu benchmark-cron          # Run periodic benchmark
"""

import argparse
import importlib.machinery
import importlib.util
import json
import os
import psutil
import sys
import time
import urllib.request
import urllib.error
import yaml

# Add the package directory to path
SERVER_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(SERVER_DIR, "lib"))

from lfm3_npu import (
    Config,
    LFM3NPUInference,
    ServerManager,
    bench_model,
    bench_concurrency,
    compare,
    convert_model,
    load_config,
    watchdog_main,
)

# Server configuration
CPU_PORT = 1238
NPU_PORT = 1239
CPU_HOST = "127.0.0.1"
NPU_HOST = "127.0.0.1"


def http_post(url, payload, timeout=60):
    """Send an HTTP POST request and return parsed JSON response."""
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def http_get(url, timeout=10):
    """Send an HTTP GET request and return parsed JSON response."""
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def generate_via_http(server, prompt, max_tokens=50, temperature=0.7, top_p=0.9):
    """Generate text via HTTP API on the specified server."""
    if server == "cpu":
        url = f"http://{CPU_HOST}:{CPU_PORT}/v1/chat/completions"
        payload = {
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens,
            "temperature": temperature,
            "top_p": top_p,
        }
    elif server == "npu":
        url = f"http://{NPU_HOST}:{NPU_PORT}/v1/chat/completions"
        payload = {
            "model": "lfm3:1.7b",
            "messages": [{"role": "user", "content": prompt}],
            "max_tokens": max_tokens,
            "temperature": temperature,
            "top_p": top_p,
        }
    else:
        raise ValueError(f"Unknown server: {server}")

    result = http_post(url, payload)
    choice = result["choices"][0]
    msg = choice["message"]
    content = msg.get("content", "")
    reasoning = msg.get("reasoning_content", "")
    # NPU server (FastFlowLM) puts responses in reasoning_content;
    # fall back to content if reasoning is empty.
    used_reasoning_fallback = False
    if not content and reasoning:
        content = reasoning
        used_reasoning_fallback = True
    return {
        "content": content,
        "reasoning": reasoning,
        "used_reasoning_fallback": used_reasoning_fallback,
        "usage": result.get("usage", {}),
        "finish_reason": choice.get("finish_reason", ""),
    }


def bench_via_http(server, prompt, max_tokens=50, iterations=3):
    """Benchmark a server via HTTP API."""
    results = []
    for i in range(iterations):
        start = time.perf_counter()
        try:
            result = generate_via_http(server, prompt, max_tokens=max_tokens)
            total = time.perf_counter() - start
            usage = result.get("usage", {})
            results.append({
                "iteration": i + 1,
                "success": True,
                "total_time": total,
                "ttft": usage.get("prefill_duration_ttft"),
                "prefill_tps": usage.get("prefill_speed_tps"),
                "decode_tps": usage.get("decoding_speed_tps"),
                "prompt_tokens": usage.get("prompt_tokens"),
                "completion_tokens": usage.get("completion_tokens"),
                "content": result["content"][:100],
            })
        except Exception as e:
            results.append({
                "iteration": i + 1,
                "success": False,
                "error": str(e),
            })
    return results


# Fleet monitor functions (defined inline to avoid circular imports)
def cmd_fleet_monitor(args) -> int:
    """Run fleet monitor across CPU and NPU servers."""
    import sys as _sys

    servers = {"CPU": CPU_PORT, "NPU": NPU_PORT}
    if args.config:
        with open(args.config) as f:
            cfg = yaml.safe_load(f)
        servers = {}
        for name, srv in cfg.get("servers", {}).items():
            servers[name] = srv.get("port", CPU_PORT if name.lower() == "cpu" else NPU_PORT)

    fleet_mod_path = os.path.join(SERVER_DIR, "bin", "lfm3-fleet-monitor")
    loader = importlib.machinery.SourceFileLoader("lfm3_fleet_monitor", fleet_mod_path)
    spec = importlib.util.spec_from_loader("lfm3_fleet_monitor", loader)
    fleet_mod = importlib.util.module_from_spec(spec)
    loader.exec_module(fleet_mod)
    fetch_server_status = fleet_mod.fetch_server_status
    evaluate_alerts = fleet_mod.evaluate_alerts
    format_status = fleet_mod.format_status
    gen_grafana_dashboard = fleet_mod.gen_grafana_dashboard
    gen_prometheus_config = fleet_mod.gen_prometheus_config

    if args.gen_prometheus_config:
        print(gen_prometheus_config(servers))
        return 0

    if args.gen_grafana_dashboard:
        print(gen_grafana_dashboard())
        return 0

    while True:
        server_statuses = {}
        for label, port in servers.items():
            server_statuses[label] = fetch_server_status(port)

        alerts = evaluate_alerts(
            server_statuses,
            min_tps=args.min_tps,
            max_ttft=args.max_ttft,
            max_error_rate=args.max_error_rate,
            max_latency_ms=args.max_latency_ms,
        )

        print(format_status(server_statuses, alerts, json_output=args.json))

        if args.once:
            return 0

        time.sleep(args.interval)

    return 0


def cmd_smoke_test(args) -> int:
    """Run smoke test / validation of all servers."""
    import subprocess
    import json

    script = os.path.join(SERVER_DIR, "scripts", "smoke_test.py")
    if not os.path.exists(script):
        print(f"Smoke test script not found: {script}", flush=True)
        return 1

    cmd = ["python3", script]
    if args.verbose:
        cmd.append("--verbose")
    if args.fix:
        cmd.append("--fix")

    print("Running smoke test...", flush=True)
    result = subprocess.run(cmd, capture_output=False)
    return result.returncode


def cmd_quality_monitor(args) -> int:
    """Run quality monitor with auto-restart on degradation."""
    import subprocess

    script = os.path.join(SERVER_DIR, "scripts", "quality_monitor.py")
    if not os.path.exists(script):
        print(f"Quality monitor script not found: {script}", flush=True)
        return 1

    cmd = ["python3", script]
    if args.interval:
        cmd.extend(["--interval", str(args.interval)])
    if args.once:
        cmd.append("--once")
    if args.fix:
        cmd.append("--fix")
    if args.verbose:
        cmd.append("--verbose")
    if args.restart_cooldown:
        cmd.extend(["--restart-cooldown", str(args.restart_cooldown)])

    print("Running quality monitor...", flush=True)
    result = subprocess.run(cmd, capture_output=False)
    return result.returncode


def cmd_benchmark_cron(args) -> int:
    """Run benchmark cron job (periodic performance validation)."""
    import subprocess

    script = os.path.join(SERVER_DIR, "scripts", "benchmark_cron.py")
    if not os.path.exists(script):
        print(f"Benchmark cron script not found: {script}", flush=True)
        return 1

    print("Running benchmark cron job...", flush=True)
    result = subprocess.run(["python3", script], capture_output=False)
    return result.returncode


def cmd_version_check(args) -> int:
    """Check for FastFlowLM version updates."""
    import subprocess

    print("Checking FastFlowLM version...", flush=True)

    # Check current version from running server
    try:
        import urllib.request, json
        data = json.loads(urllib.request.urlopen(
            "http://127.0.0.1:1239/v1/models", timeout=10
        ).read().decode("utf-8"))
        models = data.get("data", [])
        lfm_models = [m for m in models if "lfm3" in str(m.get("id", ""))]
        if lfm_models:
            print(f"  NPU model: {lfm_models[0]['id']}")
    except Exception as e:
        print(f"  Could not query NPU server: {e}", flush=True)

    # Check latest release from GitHub
    try:
        import urllib.request, json
        req = urllib.request.Request(
            "https://api.github.com/repos/ROCm/FastFlowLM/releases/latest",
            headers={"User-Agent": "lfm3-npu-tool"}
        )
        release = json.loads(urllib.request.urlopen(req, timeout=10).read().decode("utf-8"))
        latest_tag = release.get("tag_name", "unknown")
        latest_name = release.get("name", "unknown")
        print(f"  Latest release: {latest_tag} ({latest_name})")

        # Compare with known version
        current = "v1.0.12"
        if latest_tag and latest_tag != current:
            print(f"  UPDATE AVAILABLE: {current} -> {latest_tag}")
            if args.upgrade:
                print(f"  Downloading {latest_tag}...")
                assets = release.get("assets", [])
                linux_asset = None
                for a in assets:
                    if "linux" in a.get("name", "").lower() and a.get("name", "").endswith(".tar.gz"):
                        linux_asset = a
                        break
                if linux_asset:
                    download_url = linux_asset["browser_download_url"]
                    print(f"  Download URL: {download_url}")
                    print(f"  Manual upgrade: wget {download_url} && tar xzf fastflowlm_*.tar.gz")
                    print(f"  Then copy /tmp/flm to /tmp/flm-real and restart NPU service")
                else:
                    print("  No Linux release asset found")
            else:
                print("  Run 'lfm3-npu version-check --upgrade' to see download instructions")
        else:
            print(f"  Already on latest version ({current})")
    except Exception as e:
        print(f"  Could not check latest version: {e}", flush=True)

    return 0


def cmd_generate(args) -> int:
    """Generate text via HTTP API (cpu or npu server)."""
    if args.server == "npu":
        try:
            result = generate_via_http(
                "npu", args.prompt,
                max_tokens=args.max_tokens,
                temperature=args.temperature,
                top_p=args.top_p,
            )
            print(f"Prompt: '{args.prompt}'", flush=True)
            if result["reasoning"] and not result["used_reasoning_fallback"]:
                print(f"Reasoning: {result['reasoning']}", flush=True)
            print(f"Content: {result['content']}", flush=True)
            usage = result.get("usage", {})
            if usage:
                print(f"Decode: {usage.get('decoding_speed_tps', 'N/A'):.1f} tok/s, "
                      f"TTFT: {usage.get('prefill_duration_ttft', 'N/A')}s")
            return 0
        except Exception as e:
            print(f"NPU generation failed: {e}", flush=True)
            print("Is the NPU server running? Try: lfm3-npu server start npu", flush=True)
            return 1
    else:
        # CPU server via LFM3NPUInference (direct Python API)
        config = load_config()
        model_path = args.model or config.get("server.cpu.model_path")
        tokenizer_path = args.tokenizer or config.get("model.tokenizer")

        print(f"Loading CPU model: {model_path}", flush=True)
        engine = LFM3NPUInference(model_path, tokenizer_path, config)
        engine.load()
        engine.warmup()

        print(f"Prompt: '{args.prompt}'", flush=True)
        print("Generated: ", end="", flush=True)

        result = engine.generate(
            args.prompt,
            max_new_tokens=args.max_tokens,
            temperature=args.temperature,
            top_p=args.top_p,
        )
        print(result, flush=True)
        print(f"\nFull text: '{args.prompt}{result}'", flush=True)
        return 0


def cmd_server(args) -> int:
    """Start/stop/restart/check server status."""
    config = load_config()
    manager = ServerManager(config)

    if args.action == "start":
        return 0 if manager.start(args.server) else 1
    elif args.action == "stop":
        return 0 if manager.stop(args.server) else 1
    elif args.action == "restart":
        return 0 if manager.restart(args.server) else 1
    elif args.action == "status":
        manager.status(args.server)
        return 0
    return 1


def cmd_bench(args) -> int:
    """Benchmark inference performance via HTTP API."""
    servers = ["cpu", "npu"] if args.server == "both" else [args.server]

    for server in servers:
        print(f"\n{'=' * 60}")
        print(f"Benchmarking {server.upper()} server (port {CPU_PORT if server == 'cpu' else NPU_PORT})")
        print(f"{'=' * 60}")

        # Check server is reachable first
        try:
            port = CPU_PORT if server == "cpu" else NPU_PORT
            host = CPU_HOST if server == "cpu" else NPU_HOST
            health_path = "/health" if server == "cpu" else "/v1/models"
            http_get(f"http://{host}:{port}{health_path}", timeout=5)
        except Exception as e:
            print(f"Server {server} is not reachable: {e}")
            print(f"  Start it with: lfm3-npu server start {server}")
            continue

        results = bench_via_http(
            server,
            prompt=args.prompt,
            max_tokens=args.tokens,
            iterations=args.iterations,
        )

        successful = [r for r in results if r["success"]]
        if successful:
            avg_total = sum(r["total_time"] for r in successful) / len(successful)
            ttfts = [r["ttft"] for r in successful if r["ttft"] is not None]
            decodes = [r["decode_tps"] for r in successful if r["decode_tps"] is not None]
            print(f"  Successful iterations: {len(successful)}/{len(results)}")
            print(f"  Avg total time:      {avg_total:.2f}s")
            if ttfts:
                print(f"  Avg TTFT:            {sum(ttfts)/len(ttfts):.3f}s")
            if decodes:
                print(f"  Avg decode speed:    {sum(decodes)/len(decodes):.1f} tok/s")
            for r in successful:
                print(f"  Iter {r['iteration']}: {r['total_time']:.2f}s, "
                      f"decode={r['decode_tps'] or 0:.1f} tok/s, "
                      f"content='{r['content'][:60]}'")
        else:
            print("  All iterations failed.")
            for r in results:
                if not r["success"]:
                    print(f"  Iter {r['iteration']}: {r['error']}")

    return 0


def cmd_bench_batch(args) -> int:
    """Benchmark concurrent inference performance."""
    from lfm3_npu.benchmark import bench_concurrency

    config = load_config()
    model_path = args.model or config.get("model.path")
    tokenizer_path = args.tokenizer or config.get("model.tokenizer")

    concurrency_levels = None
    if args.concurrency:
        concurrency_levels = [int(c) for c in args.concurrency.split(",")]

    results = bench_concurrency(
        model_path,
        tokenizer_path,
        prompt=args.prompt,
        max_tokens=args.tokens,
        concurrency_levels=concurrency_levels,
        config=config,
    )

    print("\n=== Performance Profile Summary ===")
    best_tps = 0
    best_conc = 1
    for level in results["results"]:
        tps = level["avg_tokens_per_sec"]
        if tps > best_tps:
            best_tps = tps
            best_conc = level["concurrency"]
        print(
            f"  Concurrency {level['concurrency']:2d}: "
            f"{tps:6.1f} tok/s, "
            f"TTFT={level.get('avg_ttft_ms', 0):6.1f}ms, "
            f"prefill={level['avg_prefill_ms']:6.1f}ms"
        )
    print(
        f"\n  Best concurrency: {best_conc} "
        f"({best_tps:.1f} tok/s)"
    )
    return 0


def cmd_health(args) -> int:
    """Check server health."""
    import json

    config = load_config()
    server = args.server

    if server == "cpu":
        port = config.get("server.cpu.port", CPU_PORT)
        host = config.get("server.cpu.host", CPU_HOST)
        health_path = "/health"
    elif server == "npu":
        port = config.get("server.npu.port", NPU_PORT)
        host = config.get("server.npu.host", NPU_HOST)
        health_path = "/v1/models"
    else:
        print(f"Unknown server: {server}")
        return 1

    try:
        data = http_get(f"http://{host}:{port}{health_path}", timeout=5)
        print(f"{server.upper()} server at {host}:{port}: HEALTHY")
        print(json.dumps(data, indent=2))
        return 0
    except Exception as e:
        print(f"{server.upper()} server at {host}:{port}: UNREACHABLE ({e})")
        return 1


def cmd_convert(args) -> int:
    """Convert model to NPU-compatible format."""
    from lfm3_npu.converter import convert

    print(f"Converting model: {args.model} -> {args.output}")
    print(f"Method: {args.method}")
    output_path = convert(args.model, args.output, args.method)
    print(f"\nConversion complete: {output_path}")
    return 0


def cmd_config(args) -> int:
    """Show current configuration."""
    import yaml

    config = load_config()
    print(yaml.dump(config.to_dict(), default_flow_style=False))
    return 0


def cmd_status(args) -> int:
    """Show overall system status with health data."""
    import json
    import subprocess

    config = load_config()

    print("=" * 60)
    print("LFM3-1.7B NPU Tooling - System Status")
    print("=" * 60)

    # NPU device
    print("\n[NPU Device]")
    try:
        result = subprocess.run(
            ["xrt-smi", "examine"], capture_output=True, text=True, timeout=10
        )
        for line in result.stdout.split("\n"):
            if "NPU" in line or "Device" in line or "Architecture" in line or "Firmware" in line:
                if line.strip():
                    print(f"  {line.strip()}")
    except Exception:
        print("  xrt-smi not available")

    # Servers via ServerManager
    print("\n[Servers]")
    manager = ServerManager(config)
    try:
        manager.status(None)
    except Exception as e:
        print(f"  Error getting server status: {e}")

    # Models
    print("\n[Models]")
    model_path = config.get("model.path")
    print(f"  Active model: {model_path}")
    print(f"  Model exists: {os.path.exists(model_path)}")

    # Environment
    print("\n[Environment]")
    print(f"  Python: {config.get('npu.python_executable', '/usr/bin/python3')}")
    ld_path = config.get("npu.ld_library_path", [])
    print(f"  LD_LIBRARY_PATH parts: {len(ld_path)}")
    print(f"  FLM binary: /tmp/flm")
    print(f"  FLM NPU engine: /tmp/lib/liblfm3_npu.so")

    return 0


def cmd_compare(args) -> int:
    """Compare CPU vs NPU inference performance and output quality."""
    config = load_config()
    cpu_model = args.cpu_model or config.get("server.cpu.model_path")
    npu_model = args.npu_model or config.get("model.path")
    tokenizer_path = args.tokenizer or config.get("model.tokenizer")

    prompts = args.prompts or ["The quick brown fox", "Hello world", "Once upon a time"]

    print(f"Comparing CPU vs NPU inference")
    print(f"  CPU model:  {cpu_model}")
    print(f"  NPU model:  {npu_model}")
    print(f"  Prompts:    {len(prompts)}")
    print(f"  Max tokens: {args.max_tokens}")
    print()

    results = compare(
        cpu_model,
        npu_model,
        tokenizer_path,
        prompts,
        max_tokens=args.max_tokens,
        temperature=args.temperature,
        top_p=args.top_p,
        config=config,
    )

    summary = results["summary"]
    print("\n" + "=" * 60)
    print("FINAL COMPARISON SUMMARY")
    print("=" * 60)
    print(f"  Total prompts: {summary['total_prompts']}")
    print(f"  Text matches:  {summary['text_matches']}/{summary['total_prompts']} "
          f"({summary['match_rate']*100:.1f}%)")
    print(f"  Avg CPU:  {summary['avg_cpu_tokens_per_sec']:.1f} tok/s, "
          f"prefill={summary['avg_cpu_prefill_ms']:.1f}ms")
    print(f"  Avg NPU:  {summary['avg_npu_tokens_per_sec']:.1f} tok/s, "
          f"prefill={summary['avg_npu_prefill_ms']:.1f}ms")
    print(f"  NPU/CPU speed ratio: {summary['avg_speed_ratio']:.2f}x")
    return 0


def cmd_compare_servers(args) -> int:
    """Compare CPU vs NPU via live HTTP API servers."""
    prompts = args.prompts or ["What is 2+2?", "The capital of France is", "Write a haiku about coding"]

    print("=" * 70)
    print("LIVE SERVER COMPARISON: CPU (1238) vs NPU (1239)")
    print("=" * 70)

    # Check both servers are reachable
    servers_ok = {}
    for name, host, port, path in [
        ("cpu", CPU_HOST, CPU_PORT, "/health"),
        ("npu", NPU_HOST, NPU_PORT, "/v1/models"),
    ]:
        try:
            http_get(f"http://{host}:{port}{path}", timeout=5)
            servers_ok[name] = True
        except Exception as e:
            servers_ok[name] = False
            print(f"WARNING: {name.upper()} server not reachable: {e}")

    if not any(servers_ok.values()):
        print("No servers are reachable. Start them with:")
        print("  lfm3-npu server start cpu")
        print("  lfm3-npu server start npu")
        return 1

    all_results = []
    for prompt in prompts:
        print(f"\n{'=' * 70}")
        print(f"Prompt: '{prompt}'")
        print(f"{'=' * 70}")

        prompt_result = {"prompt": prompt}

        for server in ["cpu", "npu"]:
            if not servers_ok.get(server):
                print(f"\n{server.upper()}: SKIPPED (not reachable)")
                prompt_result[server] = {"skipped": True}
                continue

            try:
                result = generate_via_http(
                    server, prompt,
                    max_tokens=args.max_tokens,
                    temperature=args.temperature,
                    top_p=args.top_p,
                )
                usage = result.get("usage", {})
                print(f"\n{server.upper()} server:")
                if result["reasoning"]:
                    print(f"  Reasoning: {result['reasoning'][:100]}...")
                print(f"  Content: {result['content'][:150]}")
                print(f"  Decode: {usage.get('decoding_speed_tps', 'N/A')} tok/s")
                print(f"  TTFT: {usage.get('prefill_duration_ttft', 'N/A')}s")
                prompt_result[server] = {
                    "content": result["content"],
                    "reasoning": result["reasoning"],
                    "decode_tps": usage.get("decoding_speed_tps"),
                    "ttft": usage.get("prefill_duration_ttft"),
                    "success": True,
                }
            except Exception as e:
                print(f"\n{server.upper()}: FAILED - {e}")
                prompt_result[server] = {"error": str(e), "success": False}

        all_results.append(prompt_result)

    # Summary
    print(f"\n{'=' * 70}")
    print("COMPARISON SUMMARY")
    print(f"{'=' * 70}")
    for r in all_results:
        print(f"\nPrompt: '{r['prompt']}'")
        for server in ["cpu", "npu"]:
            res = r.get(server, {})
            if res.get("skipped"):
                print(f"  {server.upper()}: skipped")
            elif res.get("success"):
                print(f"  {server.upper()}: {res['decode_tps'] or 0:.1f} tok/s, "
                      f"TTFT={res['ttft'] or 0:.2f}s")
            else:
                print(f"  {server.upper()}: failed")

    return 0


def cmd_doctor(args) -> int:
    """Diagnose system health: servers, NPU hardware, environment, configs."""
    import subprocess
    import shutil

    # Source environment from env file if available (for cron/systemd context)
    env_file = "/media/scott/data/lfm3-npu-tool/etc/lfm3-npu-env.sh"
    if os.path.exists(env_file):
        with open(env_file) as f:
            for line in f:
                line = line.strip()
                if line.startswith("export ") and "=" in line:
                    key, _, val = line[7:].partition("=")
                    # Strip quotes
                    val = val.strip('"').strip("'")
                    os.environ[key.strip()] = val

    issues = []
    checks = []

    def check(name, ok, detail=""):
        status = "PASS" if ok else "FAIL"
        checks.append((name, status, detail))
        if not ok:
            issues.append(f"{name}: {detail}")

    # 1. NPU hardware
    print("=== LFM3-1.7B Doctor: System Diagnosis ===\n")

    check("xrt-smi available", shutil.which("xrt-smi") is not None,
          "xrt-smi not found in PATH")
    try:
        result = subprocess.run(
            ["xrt-smi", "examine"], capture_output=True, text=True, timeout=10
        )
        npu_found = "Strix Halo" in result.stdout or "aie2p" in result.stdout
        check("NPU hardware detected", npu_found,
              "No Strix Halo NPU found in xrt-smi output")
        if npu_found:
            # Extract NPU device details
            for line in result.stdout.split("\n"):
                if "BDF" in line or "firmware" in line.lower() or "XDNA" in line:
                    print(f"    NPU detail: {line.strip()}")
    except Exception as e:
        check("NPU hardware detected", False, f"xrt-smi failed: {e}")

    # 1b. XRT version
    try:
        result = subprocess.run(
            ["xrt-smi", "version"], capture_output=True, text=True, timeout=10
        )
        xrt_version = result.stdout.strip() if result.returncode == 0 else "unknown"
        check("XRT version available", xrt_version != "unknown",
              f"XRT version: {xrt_version[:80] if xrt_version != 'unknown' else 'not available'}")
    except Exception:
        check("XRT version available", False, "xrt-smi version failed")

    # 1c. NPU device node
    npu_dev = "/dev/accel/accel0"
    check("NPU device node exists", os.path.exists(npu_dev),
          f"{npu_dev} not found (NPU may not be accessible)")

    # 2. FLM binary
    flm_binary = "/tmp/flm"
    check("FLM binary exists", os.path.exists(flm_binary),
          f"{flm_binary} not found")
    check("FLM binary executable", os.access(flm_binary, os.X_OK) if os.path.exists(flm_binary) else False,
          f"{flm_binary} not executable")
    # FLM version
    try:
        result = subprocess.run(
            [flm_binary, "--version"], capture_output=True, text=True, timeout=10
        )
        flm_version = result.stdout.strip() or result.stderr.strip()
        check("FLM version detectable", bool(flm_version),
              f"FLM version: {flm_version[:80] if flm_version else 'not detectable'}")
    except Exception:
        check("FLM version detectable", False, "Could not run flm --version")

    # 3. FLM NPU engine
    npu_engine = "/tmp/lib/liblfm3_npu.so"
    check("FLM NPU engine exists", os.path.exists(npu_engine),
          f"{npu_engine} not found")

    # 4. Model files
    model_dir = "/home/scott/.config/flm/models/LFM3-1.7B-NPU2"
    model_files = ["config.json", "model.q4nx", "tokenizer.json", "tokenizer_config.json", "chat_template.jinja"]
    all_model_files = all(os.path.exists(os.path.join(model_dir, f)) for f in model_files) if os.path.isdir(model_dir) else False
    check("FLM model files present", all_model_files,
          f"Missing model files in {model_dir}")

    # 5. CPU server model
    cpu_model = "/media/scott/data/lfm3_oga_export/model.onnx"
    check("CPU ONNX model exists", os.path.exists(cpu_model),
          f"{cpu_model} not found")

    # 6. Environment variables
    check("XILINX_XRT set", bool(os.environ.get("XILINX_XRT")),
          "XILINX_XRT not set (needed for FLM)")
    check("LD_LIBRARY_PATH has /tmp/lib", "/tmp/lib" in os.environ.get("LD_LIBRARY_PATH", ""),
          "/tmp/lib not in LD_LIBRARY_PATH (needed for liblfm3_npu.so)")
    check("FLM_MODEL_PATH set", bool(os.environ.get("FLM_MODEL_PATH")),
          "FLM_MODEL_PATH not set (needed for FLM model discovery)")

    # 7. Server health
    manager = ServerManager(load_config())
    for sname, host, port, path in [
        ("cpu", CPU_HOST, CPU_PORT, "/health"),
        ("npu", NPU_HOST, NPU_PORT, "/v1/models"),
    ]:
        try:
            http_get(f"http://{host}:{port}{path}", timeout=5)
            check(f"{sname.upper()} server reachable", True)
        except Exception as e:
            check(f"{sname.upper()} server reachable", False, f"Not reachable on {host}:{port} ({e})")

    # 8. Disk space
    try:
        stat = shutil.disk_usage("/media/scott/data")
        free_gb = stat.free / (1024**3)
        check("Disk space > 5GB", free_gb > 5,
              f"Only {free_gb:.1f}GB free on /media/scott/data")
    except Exception as e:
        check("Disk space check", False, str(e))

    # 9. /tmp space (FLM may write temp files)
    try:
        stat = shutil.disk_usage("/tmp")
        free_gb = stat.free / (1024**3)
        check("/tmp space > 2GB", free_gb > 2,
              f"Only {free_gb:.1f}GB free on /tmp")
    except Exception as e:
        check("/tmp space check", False, str(e))

    # Print results
    for name, status, detail in checks:
        mark = "✓" if status == "PASS" else "✗"
        detail_str = f" — {detail}" if status == "FAIL" and detail else ""
        print(f"  [{mark}] {name}{detail_str}")

    print(f"\n{'=' * 50}")
    if issues:
        print(f"DOCTOR: {len(issues)} issue(s) found")
        for i, issue in enumerate(issues, 1):
            print(f"  {i}. {issue}")
        print("\nRecommended actions:")
        if any("FLM binary" in i for i in issues):
            print("  - Download FLM v1.0.12 from https://github.com/ROCm/FastFlowLM/releases/tag/v1.0.12")
            print("    Extract to /tmp/ and ensure /tmp/flm is executable")
        if any("NPU engine" in i for i in issues):
            print("  - Extract liblfm3_npu.so from FLM release to /tmp/lib/")
        if any("server reachable" in i for i in issues):
            print("  - Start servers: lfm3-npu server start cpu  lfm3-npu server start npu")
        if any("Disk space" in i or "/tmp space" in i for i in issues):
            print("  - Free disk space; use /media/scott/data for large files")
        if any("LD_LIBRARY_PATH" in i for i in issues):
            print("  - Export LD_LIBRARY_PATH=/tmp/lib:/opt/xilinx/xrt/lib:$LD_LIBRARY_PATH")
            print("    (Only needed when starting NPU server manually)")
        return 1
    else:
        print("DOCTOR: All checks passed. System is healthy.")
        return 0


def cmd_watchdog(args) -> int:
    """Run the server watchdog."""
    from lfm3_npu.watchdog import Watchdog
    config = load_config()
    watchdog = Watchdog(
        config,
        check_interval=args.interval,
        min_tps=args.min_tps,
        max_error_rate=args.max_error_rate,
        max_latency_ms=args.max_latency_ms,
        max_uptime_hours=args.max_uptime_hours,
        max_garble_ratio=args.max_garble_ratio,
        webhook_url=args.webhook,
        cooldown_seconds=args.cooldown,
        enable_degradation=args.degrade,
        min_concurrent_requests=args.min_concurrent,
    )
    if args.status:
        import json
        status = watchdog.get_status(args.servers)
        print(json.dumps(status, indent=2))
        return 0
    if args.once:
        results = watchdog.check_once(args.servers)
        for server, action_taken in results.items():
            action = "restarted" if action_taken else "healthy"
            print(f"Watchdog: {server.upper()} - {action}")
        return 0
    else:
        watchdog.run_forever(args.servers)
        return 0


def main() -> int:
    """Main entry point for the CLI."""
    parser = argparse.ArgumentParser(
        description="LFM3-1.7B NPU Inference Tooling",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # generate
    gen_parser = subparsers.add_parser("generate", help="Generate text via HTTP API")
    gen_parser.add_argument("prompt", help="Input prompt text")
    gen_parser.add_argument("--server", choices=["cpu", "npu"], default="npu",
                            help="Server to use (default: npu)")
    gen_parser.add_argument("--max-tokens", type=int, default=50, help="Max tokens to generate")
    gen_parser.add_argument("--temperature", type=float, default=0.7, help="Sampling temperature")
    gen_parser.add_argument("--top-p", type=float, default=0.9, help="Top-p sampling threshold")
    gen_parser.add_argument("--model", help="Model path (CPU only, overrides config)")
    gen_parser.add_argument("--tokenizer", help="Tokenizer path (overrides config)")
    gen_parser.set_defaults(func=cmd_generate)

    # server
    server_parser = subparsers.add_parser("server", help="Manage inference servers")
    server_parser.add_argument("action", choices=["start", "stop", "restart", "status"], help="Action")
    server_parser.add_argument("server", choices=["cpu", "npu"], help="Server to manage")
    server_parser.set_defaults(func=cmd_server)

    # bench
    bench_parser = subparsers.add_parser("bench", help="Benchmark inference via HTTP API")
    bench_parser.add_argument("--server", choices=["cpu", "npu", "both"], default="both",
                              help="Server(s) to benchmark (default: both)")
    bench_parser.add_argument("--prompt", default="The quick brown fox", help="Benchmark prompt")
    bench_parser.add_argument("--tokens", type=int, default=50, help="Tokens to generate per iteration")
    bench_parser.add_argument("--iterations", type=int, default=3, help="Number of iterations")
    bench_parser.add_argument("--model", help="Model path (overrides config)")
    bench_parser.add_argument("--tokenizer", help="Tokenizer path (overrides config)")
    bench_parser.set_defaults(func=cmd_bench)

    # perf
    perf_parser = subparsers.add_parser("perf", help="Performance profiling across concurrency levels")
    perf_parser.add_argument("--prompt", default="The quick brown fox", help="Benchmark prompt")
    perf_parser.add_argument("--tokens", type=int, default=50, help="Tokens to generate per iteration")
    perf_parser.add_argument("--concurrency", help="Comma-separated concurrency levels (e.g., 1,2,4,8)")
    perf_parser.add_argument("--model", help="Model path (overrides config)")
    perf_parser.add_argument("--tokenizer", help="Tokenizer path (overrides config)")
    perf_parser.set_defaults(func=cmd_bench_batch)

    # health
    health_parser = subparsers.add_parser("health", help="Check server health")
    health_parser.add_argument("server", choices=["cpu", "npu"], help="Server to check")
    health_parser.set_defaults(func=cmd_health)

    # convert
    convert_parser = subparsers.add_parser("convert", help="Convert model to NPU-compatible format")
    convert_parser.add_argument("--model", required=True, help="Input model path")
    convert_parser.add_argument("--output", help="Output model path")
    convert_parser.add_argument("--method", choices=["centertap", "bypass"], default="centertap", help="Conversion method")
    convert_parser.set_defaults(func=cmd_convert)

    # config
    config_parser = subparsers.add_parser("config", help="Show configuration")
    config_parser.set_defaults(func=cmd_config)

    # status
    status_parser = subparsers.add_parser("status", help="Show system status")
    status_parser.set_defaults(func=cmd_status)

    # compare
    compare_parser = subparsers.add_parser("compare", help="Compare CPU vs NPU inference (direct API)")
    compare_parser.add_argument("--cpu-model", default="/media/scott/data/lfm3_oga_export/model.onnx", help="CPU model path")
    compare_parser.add_argument("--npu-model", default="/media/scott/data/lfm3_conv_centertap.onnx", help="NPU model path")
    compare_parser.add_argument("--tokenizer", default="/media/scott/data/lfm3_oga_export/tokenizer.json", help="Tokenizer path")
    compare_parser.add_argument("--prompts", nargs="+", default=["The quick brown fox", "Hello world", "Once upon a time"],
                                help="Prompts to compare")
    compare_parser.add_argument("--max-tokens", type=int, default=30, help="Max tokens per generation")
    compare_parser.add_argument("--temperature", type=float, default=0.7, help="Sampling temperature")
    compare_parser.add_argument("--top-p", type=float, default=0.9, help="Top-p sampling threshold")
    compare_parser.set_defaults(func=cmd_compare)

    # compare-servers (live HTTP comparison)
    compare_srv_parser = subparsers.add_parser("compare-servers", help="Compare live CPU vs NPU via HTTP API")
    compare_srv_parser.add_argument("--prompts", nargs="+",
        default=["What is 2+2?", "The capital of France is", "Write a haiku about coding"],
        help="Prompts to compare")
    compare_srv_parser.add_argument("--max-tokens", type=int, default=50, help="Max tokens per generation")
    compare_srv_parser.add_argument("--temperature", type=float, default=0.7, help="Sampling temperature")
    compare_srv_parser.add_argument("--top-p", type=float, default=0.9, help="Top-p sampling threshold")
    compare_srv_parser.set_defaults(func=cmd_compare_servers)

    # doctor
    doctor_parser = subparsers.add_parser("doctor", help="Diagnose system health (servers, NPU, env, disk)")
    doctor_parser.set_defaults(func=cmd_doctor)

    # watchdog
    watchdog_parser = subparsers.add_parser("watchdog", help="Run server watchdog")
    watchdog_parser.add_argument("--servers", nargs="+", default=["cpu", "npu"],
                                 choices=["cpu", "npu"], help="Servers to monitor")
    watchdog_parser.add_argument("--interval", type=int, default=30, help="Check interval in seconds")
    watchdog_parser.add_argument("--once", action="store_true", help="Run one check and exit")
    watchdog_parser.add_argument("--daemon", action="store_true", help="Run as daemon (foreground)")
    watchdog_parser.add_argument("--min-tps", type=float, default=None,
                                 help="Minimum tokens/sec threshold (restart if below)")
    watchdog_parser.add_argument("--max-error-rate", type=float, default=None,
                                 help="Maximum error rate 0.0-1.0 (restart if above)")
    watchdog_parser.add_argument("--max-latency-ms", type=float, default=None,
                                 help="Max token latency in ms (restart if above)")
    watchdog_parser.add_argument("--webhook", type=str, default=None,
                                 help="Webhook URL for alert notifications")
    watchdog_parser.add_argument("--cooldown", type=int, default=300,
                                 help="Cooldown period between restarts (seconds)")
    watchdog_parser.add_argument("--degrade", action="store_true",
                                 help="Enable graceful degradation (reduce concurrency before restart)")
    watchdog_parser.add_argument("--min-concurrent", type=int, default=1,
                                 help="Minimum concurrent requests when degrading")
    watchdog_parser.add_argument("--max-uptime-hours", type=float, default=None,
                                 help="Max uptime in hours before auto-restart (prevents CPU quality degradation)")
    watchdog_parser.add_argument("--max-garble-ratio", type=float, default=None,
                                 help="Max garble score (0.0-1.0) before auto-restart (detects output quality degradation)")
    watchdog_parser.add_argument("--status", action="store_true",
                                 help="Show detailed status and exit")
    watchdog_parser.set_defaults(func=cmd_watchdog)

    # fleet-monitor
    fleet_parser = subparsers.add_parser("fleet-monitor", help="Fleet monitoring across servers")
    fleet_parser.add_argument("--once", action="store_true", help="Run one check and exit")
    fleet_parser.add_argument("--watch", action="store_true", help="Continuous monitoring")
    fleet_parser.add_argument("--json", action="store_true", help="JSON output format")
    fleet_parser.add_argument("--interval", type=int, default=5, help="Watch interval in seconds")
    fleet_parser.add_argument("--config", type=str, default=None,
                              help="Fleet config YAML file")
    fleet_parser.add_argument("--min-tps", type=float, default=None,
                              help="Minimum TPS threshold (alert if below)")
    fleet_parser.add_argument("--max-ttft", type=float, default=None,
                              help="Maximum TTFT in seconds (alert if above)")
    fleet_parser.add_argument("--max-error-rate", type=float, default=None,
                              help="Maximum error rate 0.0-1.0 (alert if above)")
    fleet_parser.add_argument("--max-latency-ms", type=float, default=None,
                              help="Max token latency in ms (alert if above)")
    fleet_parser.add_argument("--webhook", type=str, default=None,
                              help="Webhook URL for alert notifications")
    fleet_parser.add_argument("--history", type=str, default=None,
                              help="Append history snapshots to JSONL file")
    fleet_parser.add_argument("--gen-prometheus-config", action="store_true",
                              help="Generate Prometheus scrape config and exit")
    fleet_parser.add_argument("--gen-grafana-dashboard", action="store_true",
                              help="Generate Grafana dashboard JSON and exit")
    fleet_parser.set_defaults(func=cmd_fleet_monitor)

    smoke_parser = subparsers.add_parser(
        "smoke-test", help="Run smoke test / validation of all servers"
    )
    smoke_parser.add_argument("--verbose", action="store_true",
                              help="Verbose output")
    smoke_parser.add_argument("--fix", action="store_true",
                              help="Attempt to restart unhealthy servers via systemctl")
    smoke_parser.set_defaults(func=cmd_smoke_test)

    quality_parser = subparsers.add_parser(
        "quality-monitor", help="Run quality monitor with auto-restart on degradation"
    )
    quality_parser.add_argument("--interval", type=int, default=300,
                                help="Check interval in seconds (default: 300)")
    quality_parser.add_argument("--once", action="store_true",
                                help="Run one check and exit")
    quality_parser.add_argument("--fix", action="store_true",
                                help="Auto-restart CPU server on quality degradation")
    quality_parser.add_argument("--verbose", action="store_true",
                                help="Verbose output")
    quality_parser.add_argument("--restart-cooldown", type=int, default=600,
                                help="Min seconds between CPU restarts (default: 600)")
    quality_parser.set_defaults(func=cmd_quality_monitor)

    bench_cron_parser = subparsers.add_parser(
        "benchmark-cron", help="Run benchmark cron job (periodic performance validation)"
    )
    bench_cron_parser.set_defaults(func=cmd_benchmark_cron)

    version_parser = subparsers.add_parser(
        "version-check", help="Check for FastFlowLM version updates"
    )
    version_parser.add_argument("--upgrade", action="store_true",
                                help="Download and install latest version if available")
    version_parser.set_defaults(func=cmd_version_check)

    args = parser.parse_args()

    if args.command is None:
        parser.print_help()
        return 1

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
