#!/usr/bin/env python3
"""
LFM3-1.7B Server Manager

Start/stop/restart/check status of CPU and NPU inference servers.
"""

import sys
import os

SERVER_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(SERVER_DIR, "lib"))

from lfm3_npu import ServerManager, load_config


def main():
    if len(sys.argv) < 2:
        print("Usage: lfm3-npu-server-mgr <start|stop|restart|status> [cpu|npu]")
        print("\nExamples:")
        print("  lfm3-npu-server-mgr start npu    # Start NPU server on port 1239")
        print("  lfm3-npu-server-mgr stop npu     # Stop NPU server")
        print("  lfm3-npu-server-mgr restart cpu  # Restart CPU server on port 1238")
        print("  lfm3-npu-server-mgr status       # Show all server status")
        return 1

    action = sys.argv[1]
    server = sys.argv[2] if len(sys.argv) > 2 else "npu"

    config = load_config()
    manager = ServerManager(config)

    if action == "status":
        manager.status(server)
    else:
        success = {
            "start": manager.start,
            "stop": manager.stop,
            "restart": manager.restart,
        }[action](server)
        return 0 if success else 1

    return 0


if __name__ == "__main__":
    sys.exit(main())